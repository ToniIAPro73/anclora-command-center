# ==============================================================================
# ANCLORA COMMAND CENTER - CONFIGURACION DE ENTORNO (.env.example)
# ==============================================================================
# Copia este fichero a .env o configuralo en el entorno del proceso (systemd / supervisor).
# NUNCA incluyas secretos reales en este archivo ni lo comittees con credenciales.

# ------------------------------------------------------------------------------
# 1. Rutas y red basica
# ------------------------------------------------------------------------------
# Puerto local donde escucha el backend Node.js (default: 3024).
# El backend SIEMPRE se une a loopback (127.0.0.1); Caddy actua como proxy reverso.
COMMAND_CENTER_PORT=3024

# Ruta al workspace raiz de Anclora (default: derivado automaticamente a <repo>/../..).
# ANCLORA_WORKSPACE=/home/toni/workspace/anclora

# Ruta al directorio con la SPA compilada (default: <repo>/dist).
# COMMAND_CENTER_DIST=dist

# ------------------------------------------------------------------------------
# 2. Politica de acciones de escritura (POST /api/services/:id/action)
# ------------------------------------------------------------------------------
# Comportamiento por defecto: FAIL-CLOSED (deshabilitado).
# Para habilitar acciones de escritura en el runtime AOS (start/stop/restart),
# se requieren AMBAS condiciones simultaneamente:
#   1) COMMAND_CENTER_WRITE_ACTIONS_ENABLED=true explicito.
#   2) COMMAND_CENTER_ACTIONS_TOKEN con un valor secreto no vacio.
# Si cualquiera de las dos falta o es invalida, el endpoint responde 503 DISABLED
# sin invocar ningun proceso ni filtrar informacion.
# En runtimes serverless/no-AOS se fuerza siempre DISABLED aunque ambas variables existan.
COMMAND_CENTER_WRITE_ACTIONS_ENABLED=false

# Token secreto para autorizar operaciones de escritura mediante:
#   Authorization: Bearer <COMMAND_CENTER_ACTIONS_TOKEN>
# - Se compara en tiempo constante (timingSafeEqual con SHA-256).
# - Falta de credencial devuelve 401 UNAUTHORIZED.
# - Credencial erronea devuelve 403 FORBIDDEN.
# - NUNCA se almacena en el bundle del cliente, localStorage ni sessionStorage.
# - Para revocar acceso: cambiar o vaciar esta variable y reiniciar el backend.
COMMAND_CENTER_ACTIONS_TOKEN=

# Timeout en milisegundos para la ejecucion de comandos AOS en el backend (default: 20000).
# Se aceptan valores enteros de 100 a 120000; los valores invalidos vuelven al default.
COMMAND_CENTER_ACTION_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 3. Modos de despliegue y matriz de permisos
# ------------------------------------------------------------------------------
# DESARROLLO LOCAL (Vite dev server / loopback):
#   - Modo de solo lectura por defecto.
#   - Las acciones de escritura permanecen deshabilitadas (fail-closed).
#
# VPS-NATIVE (127.0.0.1:3024 tras Caddy cuando Infrastructure lo active):
#   - El acceso publico depende del include de autenticacion de Caddy.
#   - Las acciones de escritura requieren decision de gobernanza explicita
#     y configuracion de COMMAND_CENTER_ACTIONS_TOKEN.
#   - La SPA permanece SOLO LECTURA: el token solo sirve para clientes
#     servidor-a-servidor autenticados y no se entrega al navegador.
#   - /api/audit requiere el mismo Bearer cuando existe token; sin token devuelve
#     503 DISABLED y nunca queda publico por defecto.
#
# SERVERLESS / NO-AOS:
#   - Estrictamente SOLO LECTURA.
#   - COMMAND_CENTER_WRITE_ACTIONS_ENABLED nunca debe activarse fuera del
#     runtime VPS/AOS, dado que no existe control seguro de procesos.
